# App
ENVIRONMENT=local
SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=43200

# Database
DATABASE_URL=postgresql+asyncpg://ai_assistant:ai_assistant@localhost:5434/ai_assistant_core
REDIS_URL=redis://localhost:6380/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Telegram id of the one user allowed to see /admin/* (users-list table in
# the Mini App's Profile tab). 0 = nobody.
ADMIN_TELEGRAM_ID=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to https://openrouter.ai/api/v1 to route through OpenRouter instead of
# OpenAI directly (OPENAI_API_KEY becomes the OpenRouter key, OPENAI_MODEL
# needs the provider prefix, e.g. openai/gpt-4o-mini)
LLM_BASE_URL=
# To route through Yandex Cloud AI Studio instead (OpenAI-compatible):
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# OPENAI_API_KEY=<AI Studio API key>
# OPENAI_MODEL=gpt://<folder_id>/yandexgpt/latest
# YANDEX_FOLDER_ID=<folder_id>  (required in addition to the model URI - see app/llm/factory.py)
YANDEX_FOLDER_ID=

# Yandex SpeechKit (voice message / Mini App mic transcription) - separate
# from OPENAI_API_KEY above, since LLM_PROVIDER may point at a different
# provider (e.g. DeepSeek) while speech-to-text still needs a real Yandex
# Cloud AI Studio key. Also uses its OWN folder id below, NOT
# YANDEX_FOLDER_ID above - that one used to be reused for both, which
# silently attached Yandex-only LLM headers to every DeepSeek request.
YANDEX_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=

# Google Calendar (OAuth) - client ID/secret from Google Cloud Console
# (APIs & Services > Credentials). Redirect URI must exactly match what's
# registered there.
APP_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback

# Fernet key for encrypting OAuth tokens at rest - generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=

# Serper.dev (web search, Google Search API wrapper) - app-level key from
# serper.dev, not per-user
SERPER_API_KEY=

# ЮKassa (YooKassa) - use a test shop's shopId/secretKey while developing
# (yookassa.ru/docs/support/merchant/payments/implement/test-store), swap
# for the real shop's once merchant registration is approved - no code
# change needed either way.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Anthropic Claude - used only for the isolated multi-task voice-batch
# extraction step (app/orchestrator/agent.py), not the main LLM_PROVIDER
# loop above. Leave empty to skip that step entirely (no error, no crash).
ANTHROPIC_API_KEY=
